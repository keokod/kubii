def mesurer_gpio(gpio):

    compteur = 0


    def front(channel):

        nonlocal compteur
        compteur += 1



    GPIO.setup(
        gpio,
        GPIO.IN
    )


    GPIO.add_event_detect(
        gpio,
        GPIO.RISING,
        callback=front
    )


    time.sleep(1)


    GPIO.remove_event_detect(
        gpio
    )


    return compteur




